# ProjectAaru / StudyWallah Environment Configuration
# Copy to .env and replace placeholder values before running.

# Server
PORT=8080
HOST=0.0.0.0
APP_ENV=development

# MongoDB (local Docker Compose bound to 127.0.0.1 only)
MONGO_INITDB_ROOT_USERNAME=studywallah_admin
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_mongo_password
MONGO_URI=mongodb://studywallah_admin:change_me_strong_mongo_password@127.0.0.1:27017/studywallah?authSource=admin
MONGO_DB_NAME=studywallah

# Security (minimum 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_64_char_random_hex_secret_key_do_not_use_in_prod
JWT_EXPIRY_HOURS=168

# Invitation & Timezone
INVITATION_EXPIRY_HOURS=24
TIMEZONE=Asia/Kolkata
REQUEST_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=*
